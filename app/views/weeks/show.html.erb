<% content_for :title, "Move the Spark — semaine du #{l(@week_start, format: :short)}" %>

<%= render "shared/screen_header", kicker: "semaine", title: "#{l(@week_start, format: :short)} — #{l(@week_end, format: :short)}" %>

<div class="flex items-center justify-between mb-4">
  <%= link_to "← semaine préc.", week_path(date: @previous_week_start), class: "text-sm text-accent font-medium" %>
  <%= link_to "semaine suiv. →", week_path(date: @next_week_start), class: "text-sm text-accent font-medium" %>
</div>

<div class="rounded-[20px] bg-ink text-paper p-[18px] mb-5">
  <div class="font-mono text-[10px] tracking-[.16em] uppercase opacity-60">Rythme de la semaine</div>

  <div class="flex items-end gap-1.5 h-[74px] my-4">
    <% @days.each do |day| %>
      <% today = day[:date] == Date.current %>
      <% activity = day[:goals].size + day[:appointments].size %>
      <% done = day[:goals].count { |g| @completions[[ g.id, g.occurrence_date(day[:date]) ] ] } %>
      <% ratio = day[:goals].empty? ? 0 : (done.to_f / day[:goals].size) %>
      <% height = [ 10 + activity * 9 + (ratio * 12).round, 74 ].min %>
      <div class="flex-1 flex flex-col items-center gap-1.5">
        <div class="w-full rounded-t-md rounded-b-sm transition-[height] <%= today ? "bg-accent" : "bg-white/20" %>" style="height: <%= height %>px"></div>
        <span class="font-mono text-[9.5px] uppercase <%= today ? "opacity-100" : "opacity-55" %>"><%= l(day[:date], format: "%a") %></span>
      </div>
    <% end %>
  </div>

  <div class="text-[12.5px] opacity-70 leading-relaxed flex items-center gap-1.5">
    <%= render "shared/flame_glyph", size: "w-2.5 h-2.5", color: "bg-accent" %>
    <%= @weekly_streak %> semaine<%= "s" if @weekly_streak != 1 %> de suite
    · <%= @weekly_goals.count { |g| @completions[[ g.id, @week_start ]] } %>/<%= @weekly_goals.size %> objectifs de la semaine
    · <%= @days.sum { |d| d[:appointments].size } %> rendez-vous
  </div>
</div>

<section class="bg-paper rounded-[20px] border border-line divide-y divide-line mb-6">
  <h2 class="px-4 pt-3 pb-1 font-mono text-[10px] font-semibold uppercase tracking-[.14em] text-dim">Objectifs de la semaine</h2>

  <% if @weekly_goals.empty? %>
    <p class="px-4 pb-4 text-sm text-dim">Aucun objectif hebdomadaire.</p>
  <% else %>
    <% @weekly_goals.each do |goal| %>
      <div class="px-4">
        <%= render "goals/goal", goal: goal, reference_date: @week_start, completion: @completions[[ goal.id, @week_start ]], plannable: false %>
      </div>
    <% end %>
  <% end %>
</section>

<div class="space-y-3 pb-4">
  <% @days.each do |day| %>
    <% today = day[:date] == Date.current %>
    <section class="bg-paper rounded-[20px] border divide-y divide-line <%= today ? "border-accent" : "border-line" %>">
      <h2 class="px-4 pt-3 pb-1 font-mono text-[10px] font-semibold uppercase tracking-[.14em] <%= today ? "text-accent" : "text-dim" %>">
        <%= link_to l(day[:date], format: :long).capitalize, day_path(date: day[:date]) %>
        <%= " · aujourd'hui" if today %>
      </h2>

      <% if day[:goals].empty? && day[:appointments].empty? %>
        <p class="px-4 pb-3 text-sm text-dim">Rien de prévu.</p>
      <% else %>
        <% day[:goals].each do |goal| %>
          <div class="px-4">
            <%= render "goals/goal", goal: goal, reference_date: goal.occurrence_date(day[:date]), completion: @completions[[ goal.id, goal.occurrence_date(day[:date]) ] ], plannable: false %>
          </div>
        <% end %>
        <% day[:appointments].each do |appointment| %>
          <div class="px-4">
            <%= render "appointments/appointment", appointment: appointment %>
          </div>
        <% end %>
      <% end %>
    </section>
  <% end %>
</div>

<%= link_to "+ Objectif récurrent hebdomadaire", new_goal_path(recurring: true, frequency: "weekly"), data: { turbo_frame: "sheet" },
      class: "block text-center py-3.5 rounded-2xl bg-ink text-paper text-[13.5px] font-semibold mb-4" %>
