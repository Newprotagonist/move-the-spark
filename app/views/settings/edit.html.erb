<% content_for :title, "Réglages — Move the Spark" %>

<%= render layout: "shared/sheet_shell", locals: { title: "Réglages" } do %>
  <div data-controller="push-subscription" class="flex items-center justify-between gap-4 px-4 py-4 rounded-2xl bg-paper border border-line mb-3">
    <div>
      <div class="text-[13.5px] font-semibold">Notifications push</div>
      <div class="text-[11.5px] text-dim mt-0.5 leading-snug">Rappels de rendez-vous et objectifs non faits</div>
    </div>
    <button type="button" data-push-subscription-target="button" data-action="push-subscription#toggle"
            class="shrink-0 text-xs font-semibold px-3 py-2 rounded-full border border-line bg-paper min-h-9">
      Activer
    </button>
  </div>

  <%= form_with model: @setting, url: settings_path, method: :patch, class: "space-y-3", data: { turbo_frame: "_top" } do |f| %>
    <% if @setting.errors.any? %>
      <div class="rounded-2xl bg-red-50 text-red-800 text-sm px-4 py-3">
        <p class="font-medium mb-1"><%= pluralize(@setting.errors.count, "erreur") %> :</p>
        <ul class="list-disc list-inside">
          <% @setting.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="px-4 py-4 rounded-2xl bg-paper border border-line" data-controller="chip-picker">
      <div class="flex items-baseline justify-between">
        <%= f.label :points_per_goal, "Étincelles par objectif", class: "text-[13.5px] font-semibold" %>
        <span class="font-mono text-[13px] text-accent"><%= @setting.points_per_goal %> étincelles</span>
      </div>
      <div class="flex gap-1.5 mt-3 flex-wrap">
        <% [ 5, 10, 15, 25 ].each do |v| %>
          <button type="button" data-chip-picker-target="chip" data-chip-value="<%= v %>" data-action="chip-picker#pick"
                  class="px-3.5 py-2 rounded-full text-[12.5px] font-semibold border border-line bg-paper min-h-9"><%= v %> étincelles</button>
        <% end %>
      </div>
      <%= f.number_field :points_per_goal, min: 1, data: { "chip-picker-target": "input" },
            class: "mt-3 w-full box-border border border-line bg-paper rounded-2xl px-3.5 py-2.5 text-[14px] focus:outline-none focus:ring-2 focus:ring-accent" %>
    </div>

    <div class="px-4 py-4 rounded-2xl bg-paper border border-line" data-controller="chip-picker">
      <div class="flex items-baseline justify-between">
        <%= f.label :daily_goal_reminder_time, "Rappel du soir", class: "text-[13.5px] font-semibold" %>
        <span class="font-mono text-[13px] text-accent"><%= @setting.daily_goal_reminder_time&.strftime("%H:%M") %></span>
      </div>
      <p class="text-[11.5px] text-dim mt-1">Pour les objectifs du jour non encore faits.</p>
      <div class="flex gap-1.5 mt-3 flex-wrap">
        <% [ "18:00", "20:00", "21:30", "22:00" ].each do |v| %>
          <button type="button" data-chip-picker-target="chip" data-chip-value="<%= v %>" data-action="chip-picker#pick"
                  class="px-3.5 py-2 rounded-full text-[12.5px] font-mono font-semibold border border-line bg-paper min-h-9"><%= v %></button>
        <% end %>
      </div>
      <%= f.time_field :daily_goal_reminder_time, data: { "chip-picker-target": "input" },
            class: "mt-3 w-full box-border border border-line bg-paper rounded-2xl px-3.5 py-2.5 text-[14px] focus:outline-none focus:ring-2 focus:ring-accent" %>
    </div>

    <div class="px-4 py-4 rounded-2xl bg-paper border border-line" data-controller="chip-picker">
      <div class="flex items-baseline justify-between">
        <%= f.label :default_appointment_lead_minutes, "Rappel avant un rdv", class: "text-[13.5px] font-semibold" %>
        <span class="font-mono text-[13px] text-accent"><%= @setting.default_appointment_lead_minutes %> min</span>
      </div>
      <div class="flex gap-1.5 mt-3 flex-wrap">
        <% [ 10, 30, 60, 120 ].each do |v| %>
          <button type="button" data-chip-picker-target="chip" data-chip-value="<%= v %>" data-action="chip-picker#pick"
                  class="px-3.5 py-2 rounded-full text-[12.5px] font-semibold border border-line bg-paper min-h-9"><%= v %> min</button>
        <% end %>
      </div>
      <%= f.number_field :default_appointment_lead_minutes, min: 1, data: { "chip-picker-target": "input" },
            class: "mt-3 w-full box-border border border-line bg-paper rounded-2xl px-3.5 py-2.5 text-[14px] focus:outline-none focus:ring-2 focus:ring-accent" %>
    </div>

    <div class="px-4 py-4 rounded-2xl bg-paper border border-line" data-controller="chip-picker">
      <div class="flex items-baseline justify-between">
        <%= f.label :streak_bonus_cap, "Bonus de flamme", class: "text-[13.5px] font-semibold" %>
        <span class="font-mono text-[13px] text-accent"><%= @setting.streak_bonus_cap %> étincelles max</span>
      </div>
      <p class="text-[11.5px] text-dim mt-1">Étincelles en plus quand ta flamme s'allonge. 0 pour désactiver.</p>
      <div class="flex gap-1.5 mt-3 flex-wrap">
        <% [ 0, 5, 10, 20 ].each do |v| %>
          <button type="button" data-chip-picker-target="chip" data-chip-value="<%= v %>" data-action="chip-picker#pick"
                  class="px-3.5 py-2 rounded-full text-[12.5px] font-semibold border border-line bg-paper min-h-9"><%= v %> étincelles</button>
        <% end %>
      </div>
      <%= f.number_field :streak_bonus_cap, min: 0, data: { "chip-picker-target": "input" },
            class: "mt-3 w-full box-border border border-line bg-paper rounded-2xl px-3.5 py-2.5 text-[14px] focus:outline-none focus:ring-2 focus:ring-accent" %>
    </div>

    <div class="pt-2">
      <%= f.submit "Enregistrer", class: "w-full py-3.5 rounded-2xl bg-ink text-paper text-center text-[14.5px] font-semibold" %>
    </div>
  <% end %>
<% end %>
