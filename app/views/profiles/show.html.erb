<% content_for :title, "Move the Spark — Moi" %>

<%= render "shared/screen_header", kicker: "profil", title: "Ta progression" %>

<div class="relative overflow-hidden rounded-[22px] bg-ink text-paper p-5 pb-6 mb-4">
  <div class="relative flex items-center justify-between font-mono text-[9.5px] tracking-[.18em] uppercase">
    <span class="opacity-45">Ton foyer</span>
    <span class="flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/10">
      <span class="opacity-50">niv.</span> <span><%= level_for_points(@total_points) %></span>
    </span>
  </div>

  <div class="relative h-[150px] flex items-end justify-center my-1" data-hearth-tier="<%= level_tier_index(level_for_points(@total_points)) %>">
    <%= render "shared/hearth_scene",
          layers: HearthScene.for_tier(level_tier_index(level_for_points(@total_points))).layers,
          html_class: "animate-[hearth-enter_1.2s_cubic-bezier(.22,.8,.28,1)_both]" %>
  </div>

  <div class="relative text-center">
    <div class="font-serif-display text-[28px] leading-none"><%= level_tier_name(level_for_points(@total_points)) %></div>
    <div class="flex items-baseline justify-center gap-1.5 mt-1.5">
      <span class="font-mono text-lg"><%= @total_points %></span>
      <span class="text-xs opacity-55">étincelles</span>
    </div>
  </div>

  <div class="relative mt-3.5">
    <div class="h-1.5 rounded-full bg-white/15 overflow-hidden">
      <div class="h-full bg-accent transition-[width]" style="width: <%= level_progress_percent(@total_points) %>%"></div>
    </div>
    <div class="font-mono text-[10px] opacity-50 mt-2 text-center">
      <%= points_to_next_level(@total_points) %> étincelles avant le niveau <%= level_for_points(@total_points) + 1 %>
    </div>
  </div>
</div>

<div class="flex gap-2.5 mb-4">
  <div class="flex-1 rounded-[18px] bg-paper border border-line p-3.5">
    <div class="font-mono text-[9.5px] tracking-[.14em] uppercase text-dim">Jours de suite</div>
    <div class="flex items-end gap-1 h-[34px] mt-2.5">
      <% [ 58, 70, 64, 82, 76, 94, 100 ].each_with_index do |bar_height, i| %>
        <% bar_on = i < [ @daily_streak, 7 ].min %>
        <span class="flex-1 rounded-t-[3px] rounded-b-[1.5px] origin-bottom animate-[grow-up_.5s_cubic-bezier(.22,.8,.28,1)_both] <%= bar_on ? "bg-gradient-to-t from-[oklch(0.5_0.16_32)] to-[oklch(0.79_0.17_62)]" : "bg-line" %>"
              style="height: <%= bar_on ? bar_height : 26 %>%; animation-delay: <%= i * 55 %>ms"></span>
      <% end %>
    </div>
    <div class="font-serif-display text-[28px] leading-none mt-2.5"><%= @daily_streak %></div>
    <div class="text-[11px] text-dim mt-0.5">jour<%= "s" if @daily_streak != 1 %> de suite</div>
  </div>
  <div class="flex-1 rounded-[18px] bg-paper border border-line p-3.5">
    <div class="font-mono text-[9.5px] tracking-[.14em] uppercase text-dim">Focus</div>
    <div class="h-[34px] flex items-end mt-2.5">
      <div class="w-full h-[7px] rounded-full bg-line overflow-hidden">
        <div class="h-full bg-gradient-to-r from-[oklch(0.56_0.16_32)] to-accent transition-[width]"
             style="width: <%= [ (@focus_seconds_this_week.to_f / 3600 / 5 * 100).round, 100 ].min %>%"></div>
      </div>
    </div>
    <div class="font-serif-display text-[28px] leading-none mt-2.5"><%= (@focus_seconds_this_week.to_f / 3600).round(1) %> h</div>
    <div class="text-[11px] text-dim mt-0.5">objectif 5 h / semaine</div>
  </div>
</div>

<div class="rounded-[18px] bg-paper border border-line p-4 mb-4">
  <div class="font-mono text-[10px] tracking-[.16em] uppercase text-dim mb-3">5 dernières semaines</div>
  <div class="grid grid-cols-7 gap-1.5">
    <% @heatmap.cells.each do |cell| %>
      <div class="aspect-square rounded-[5px] <%= [ "bg-line/50", "bg-accent/25", "bg-accent/60", "bg-accent" ][cell.level] %>"
           title="<%= l(cell.date, format: :default) %>"></div>
    <% end %>
  </div>
  <div class="flex justify-between mt-2.5 font-mono text-[9.5px] text-faint">
    <span>L M M J V S D</span>
    <span><%= @heatmap.active_days_count %>/<%= ActivityHeatmap::DAYS %> jours actifs</span>
  </div>
</div>

<%= link_to stats_path,
      class: "flex items-center justify-between px-4 py-4 rounded-[18px] bg-paper border border-line mb-3" do %>
  <span class="text-sm font-semibold">Statistiques</span>
  <span class="text-dim">→</span>
<% end %>

<%= link_to archived_goals_path,
      class: "flex items-center justify-between px-4 py-4 rounded-[18px] bg-paper border border-line mb-3" do %>
  <span class="text-sm font-semibold">Objectifs archivés</span>
  <span class="text-dim font-mono text-[12px]"><%= @archived_goals_count %> →</span>
<% end %>

<%= link_to edit_settings_path, data: { turbo_frame: "sheet" },
      class: "flex items-center justify-between px-4 py-4 rounded-[18px] bg-paper border border-line mb-4" do %>
  <span class="text-sm font-semibold">Réglages &amp; notifications</span>
  <span class="text-dim">→</span>
<% end %>
