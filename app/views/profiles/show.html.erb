<% content_for :title, "Move the Spark — Moi" %>

<%= render "shared/screen_header", kicker: "profil", title: "Ta progression" %>

<div class="relative overflow-hidden rounded-[22px] bg-ink text-paper p-5 mb-4">
  <div class="absolute -right-10 -top-10 w-[150px] h-[150px] rounded-full bg-accent opacity-20"></div>

  <div class="relative font-mono text-[10px] tracking-[.16em] uppercase opacity-60">Total</div>
  <div class="relative flex items-baseline gap-2 mt-2">
    <span class="font-serif-display text-[58px] leading-none"><%= @total_points %></span>
    <span class="text-[13px] opacity-70">étincelles</span>
  </div>

  <div class="relative flex items-center gap-2.5 mt-[18px]">
    <div class="flex-1 h-1.5 rounded-full bg-white/15 overflow-hidden">
      <div class="h-full bg-accent transition-[width]" style="width: <%= level_progress_percent(@total_points) %>%"></div>
    </div>
    <span class="font-mono text-[10.5px] opacity-80 shrink-0">NIV. <%= level_for_points(@total_points) %></span>
  </div>
  <div class="relative text-xs opacity-60 mt-2">
    <span class="font-semibold opacity-90"><%= level_tier_name(level_for_points(@total_points)) %></span>
    · <%= points_to_next_level(@total_points) %> étincelles avant le niveau <%= level_for_points(@total_points) + 1 %>
  </div>
</div>

<div class="flex gap-2.5 mb-4">
  <div class="flex-1 rounded-[18px] bg-paper border border-line p-3.5">
    <div class="font-serif-display text-[30px] leading-none"><%= @daily_streak %></div>
    <div class="text-[11.5px] text-dim mt-1">jour<%= "s" if @daily_streak != 1 %> de suite</div>
  </div>
  <div class="flex-1 rounded-[18px] bg-paper border border-line p-3.5">
    <div class="font-serif-display text-[30px] leading-none"><%= (@focus_seconds_this_week.to_f / 3600).round(1) %></div>
    <div class="text-[11.5px] text-dim mt-1">h focus cette semaine</div>
  </div>
</div>

<div class="rounded-[18px] bg-paper border border-line p-4 mb-4">
  <div class="font-mono text-[10px] tracking-[.16em] uppercase text-dim mb-3">5 dernières semaines</div>
  <div class="grid grid-cols-7 gap-1.5">
    <% @heatmap.cells.each do |cell| %>
      <div class="aspect-square rounded-[5px] <%= [ "bg-line/50", "bg-accent/25", "bg-accent/60", "bg-accent" ][cell.level] %>"
           title="<%= l(cell.date, format: :default) %>"></div>
    <% end %>
  </div>
  <div class="flex justify-between mt-2.5 font-mono text-[9.5px] text-faint">
    <span>L M M J V S D</span>
    <span><%= @heatmap.active_days_count %>/<%= ActivityHeatmap::DAYS %> jours actifs</span>
  </div>
</div>

<%= link_to stats_path,
      class: "flex items-center justify-between px-4 py-4 rounded-[18px] bg-paper border border-line mb-3" do %>
  <span class="text-sm font-semibold">Statistiques</span>
  <span class="text-dim">→</span>
<% end %>

<%= link_to archived_goals_path,
      class: "flex items-center justify-between px-4 py-4 rounded-[18px] bg-paper border border-line mb-3" do %>
  <span class="text-sm font-semibold">Objectifs archivés</span>
  <span class="text-dim font-mono text-[12px]"><%= @archived_goals_count %> →</span>
<% end %>

<%= link_to edit_settings_path, data: { turbo_frame: "sheet" },
      class: "flex items-center justify-between px-4 py-4 rounded-[18px] bg-paper border border-line mb-4" do %>
  <span class="text-sm font-semibold">Réglages &amp; notifications</span>
  <span class="text-dim">→</span>
<% end %>
