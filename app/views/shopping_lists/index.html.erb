<% content_for :title, "Listes de courses — Planner" %>

<div class="flex items-center justify-between mb-4">
  <h1 class="text-lg font-semibold">Listes de courses</h1>
  <%= link_to "+ Liste", new_shopping_list_path, class: "text-sm px-3 py-2 rounded-md bg-indigo-600 text-white hover:bg-indigo-700" %>
</div>

<section class="bg-white rounded-lg shadow-sm divide-y divide-gray-100">
  <% if @shopping_lists.empty? %>
    <p class="p-4 text-sm text-gray-400">Aucune liste pour l'instant.</p>
  <% else %>
    <% @shopping_lists.each do |list| %>
      <div class="flex items-center justify-between px-4 py-3">
        <%= link_to list.name, shopping_list_path(list), class: "font-medium hover:underline" %>
        <span class="text-xs text-gray-400">
          <%= list.shopping_list_items.count %> article<%= "s" if list.shopping_list_items.count != 1 %>
        </span>
      </div>
    <% end %>
  <% end %>
</section>
