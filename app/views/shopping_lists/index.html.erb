<% content_for :title, "Listes de courses — Planner" %>

<%= render "shared/screen_header", kicker: "courses", title: "Listes" %>

<%= link_to "+ Liste", new_shopping_list_path,
      class: "block text-center py-3.5 rounded-2xl bg-ink text-paper text-[13.5px] font-semibold mb-5" %>

<section class="bg-paper rounded-[20px] border border-line divide-y divide-line">
  <% if @shopping_lists.empty? %>
    <p class="p-4 text-sm text-dim">Aucune liste pour l'instant.</p>
  <% else %>
    <% @shopping_lists.each do |list| %>
      <div class="flex items-center justify-between px-4 py-3.5">
        <%= link_to list.name, shopping_list_path(list), class: "text-[14.5px] font-semibold" %>
        <span class="font-mono text-[10.5px] text-dim">
          <%= list.shopping_list_items.count %> article<%= "s" if list.shopping_list_items.count != 1 %>
        </span>
      </div>
    <% end %>
  <% end %>
</section>
