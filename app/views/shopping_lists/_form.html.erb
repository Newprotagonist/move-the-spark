<%= form_with model: shopping_list, class: "space-y-5" do |f| %>
  <% if shopping_list.errors.any? %>
    <div class="rounded-2xl bg-red-50 text-red-800 text-sm px-4 py-3">
      <p class="font-medium mb-1"><%= pluralize(shopping_list.errors.count, "erreur") %> :</p>
      <ul class="list-disc list-inside">
        <% shopping_list.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :name, "Nom de la liste", class: "block font-mono text-[10px] tracking-[.14em] uppercase text-dim mb-1.5" %>
    <%= f.text_field :name, autofocus: true, required: true,
          class: "w-full box-border border border-line bg-paper rounded-2xl px-3.5 py-3 text-[15px] focus:outline-none focus:ring-2 focus:ring-accent" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "flex-1 py-3.5 rounded-2xl bg-ink text-paper text-center text-[14.5px] font-semibold" %>
    <%= link_to "Annuler", request.referer || shopping_lists_path, class: "text-sm text-dim font-medium py-2" %>
  </div>
<% end %>
