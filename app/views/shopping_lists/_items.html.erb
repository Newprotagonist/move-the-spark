<section id="shopping_list_items" class="bg-paper rounded-[20px] border border-line divide-y divide-line mb-6">
  <% if shopping_list.shopping_list_items.empty? %>
    <p class="p-4 text-sm text-dim">Liste vide.</p>
  <% else %>
    <% shopping_list.shopping_list_items.each do |item| %>
      <div class="px-4">
        <%= render "shopping_list_items/item", item: item %>
      </div>
    <% end %>
  <% end %>
</section>
