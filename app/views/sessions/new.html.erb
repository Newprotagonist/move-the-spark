<% content_for :title, "Move the Spark — Connexion" %>

<div class="min-h-screen flex items-center justify-center px-5 bg-bg">
  <div class="w-full max-w-[360px]">
    <div class="text-center mb-7">
      <h1 class="font-serif-display text-[32px] leading-none">spark<span class="italic text-accent">.</span></h1>
    </div>

    <% if alert = flash[:alert] %>
      <p role="alert" class="mb-4 rounded-2xl px-4 py-3 text-sm bg-red-100 text-red-800"><%= alert %></p>
    <% end %>
    <% if notice = flash[:notice] %>
      <p role="status" class="mb-4 rounded-2xl px-4 py-3 text-sm bg-accent-soft text-ink"><%= notice %></p>
    <% end %>

    <%= form_with url: session_url, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "Identifiant", class: "block font-mono text-[10px] tracking-[.14em] uppercase text-dim mb-1.5" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
              value: params[:email_address],
              class: "w-full box-border border border-line bg-paper rounded-2xl px-3.5 py-3 text-[15px] focus:outline-none focus:ring-2 focus:ring-accent" %>
      </div>

      <div>
        <%= form.label :password, "Mot de passe", class: "block font-mono text-[10px] tracking-[.14em] uppercase text-dim mb-1.5" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
              class: "w-full box-border border border-line bg-paper rounded-2xl px-3.5 py-3 text-[15px] focus:outline-none focus:ring-2 focus:ring-accent" %>
      </div>

      <%= form.submit "Se connecter",
            class: "w-full py-3.5 rounded-2xl bg-ink text-paper text-[15px] font-semibold cursor-pointer" %>
    <% end %>
  </div>
</div>
