<% content_for :title, "Rendez-vous à venir — Planner" %>

<%= render "shared/screen_header", kicker: "à venir", title: "Rendez-vous" %>

<%= link_to "+ Nouveau rendez-vous", new_appointment_path, data: { turbo_frame: "sheet" },
      class: "block text-center py-3.5 rounded-2xl bg-ink text-paper text-[13.5px] font-semibold mb-5" %>

<% if @appointments.empty? %>
  <p class="text-sm text-dim">Aucun rendez-vous à venir.</p>
<% else %>
  <div class="space-y-6">
    <% @appointments.group_by { |a| a.starts_at.to_date }.each do |date, appointments_on_date| %>
      <div>
        <div class="flex items-baseline gap-2 mb-2">
          <span class="font-serif-display text-xl"><%= l(date, format: :long) %></span>
          <span class="font-mono text-[10.5px] text-dim uppercase tracking-[.1em]"><%= relative_day_label(date) %></span>
        </div>
        <div class="bg-paper rounded-[20px] border border-line divide-y divide-line">
          <% appointments_on_date.each do |appointment| %>
            <div class="px-4">
              <%= render "appointments/appointment", appointment: appointment %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
