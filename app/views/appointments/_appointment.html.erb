<div id="<%= dom_id(appointment) %>" class="flex items-center gap-3 py-2">
  <span class="inline-flex h-6 w-14 items-center justify-center rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold shrink-0">
    <%= l(appointment.starts_at, format: :time_only) %>
  </span>

  <div class="flex-1 min-w-0">
    <p class="truncate"><%= appointment.title %></p>
    <% if appointment.location.present? %>
      <p class="text-xs text-gray-400 truncate"><%= appointment.location %></p>
    <% end %>
  </div>

  <%= link_to "Modifier", edit_appointment_path(appointment), class: "text-xs text-gray-400 hover:text-gray-600 shrink-0" %>
</div>
