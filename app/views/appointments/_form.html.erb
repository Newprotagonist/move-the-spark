<%= form_with model: appointment, class: "space-y-4" do |f| %>
  <% if appointment.errors.any? %>
    <div class="rounded-md bg-red-50 text-red-800 text-sm px-4 py-3">
      <p class="font-medium mb-1"><%= pluralize(appointment.errors.count, "erreur") %> :</p>
      <ul class="list-disc list-inside">
        <% appointment.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Titre", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", autofocus: true %>
  </div>

  <div>
    <%= f.label :starts_at, "Date et heure", class: "block text-sm font-medium text-gray-700" %>
    <%= f.datetime_field :starts_at, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :location, "Lieu (optionnel)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :location, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :notes, "Notes (optionnel)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :notes, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :reminder_lead_minutes, "Rappel avant le rdv (minutes, optionnel)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.number_field :reminder_lead_minutes, min: 1, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    <p class="text-xs text-gray-400 mt-1">Par défaut : <%= Setting.instance.default_appointment_lead_minutes %> min avant.</p>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "px-4 py-2 rounded-md bg-indigo-600 text-white text-sm hover:bg-indigo-700" %>
    <%= link_to "Annuler", request.referer || appointments_path, class: "text-sm text-gray-500 hover:underline" %>
    <% if appointment.persisted? %>
      <%= button_to "Supprimer", appointment_path(appointment), method: :delete,
            class: "text-sm text-red-600 hover:underline bg-transparent border-0 p-0",
            form: { class: "ml-auto", data: { turbo_confirm: "Supprimer ce rendez-vous ?" } } %>
    <% end %>
  </div>
<% end %>
