<% content_for :title, "Planner — #{l(@date, format: :long)}" %>

<%= render "shared/screen_header", kicker: (@date == Date.current ? "aujourd'hui" : l(@date, format: :short)),
      title: l(@date, format: :long).capitalize %>

<%= render "progress_ring" %>

<div data-controller="planning" class="relative">
  <%= render "checklist" %>
  <%= render "ribbon" %>

  <%= form_with url: "/goals/0/schedule", method: :patch, data: { planning_target: "form" }, class: "hidden" do |f| %>
    <%= f.hidden_field :hour, data: { "planning-target": "hourField" } %>
    <%= f.hidden_field :date, value: @date %>
  <% end %>

  <div data-planning-target="cancelBar"
       class="hidden fixed left-3.5 right-3.5 bottom-24 z-20 flex items-center gap-2.5 px-3.5 py-3 rounded-2xl bg-ink text-paper shadow-lg">
    <span data-planning-target="cancelLabel" class="flex-1 text-[12.5px] leading-snug"></span>
    <button type="button" data-action="planning#cancel" class="font-mono text-[10.5px] opacity-70 p-2 shrink-0">ANNULER</button>
  </div>
</div>
