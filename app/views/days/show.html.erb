<% content_for :title, "Planner — #{l(@date, format: :long)}" %>

<div class="flex items-center justify-between mb-6">
  <%= link_to "← #{l(@previous_date, format: :short)}", day_path(date: @previous_date), class: "text-sm text-indigo-600 hover:underline" %>
  <h1 class="text-lg font-semibold capitalize"><%= l(@date, format: :long) %></h1>
  <%= link_to "#{l(@next_date, format: :short)} →", day_path(date: @next_date), class: "text-sm text-indigo-600 hover:underline" %>
</div>

<% if @today_progress %>
  <p class="text-sm text-gray-500 mb-4">
    <%= @today_progress[:done] %>/<%= @today_progress[:total] %> objectif<%= "s" if @today_progress[:total] != 1 %> du jour accompli<%= "s" if @today_progress[:done] != 1 %>
  </p>
<% end %>

<%# One combined list: goals (no fixed time) first, then appointments in chronological order — no separate sections. %>
<section class="bg-white rounded-lg shadow-sm divide-y divide-gray-100 mb-6">
  <% if @daily_goals.empty? && @weekly_goals.empty? && @appointments.empty? %>
    <p class="px-4 py-4 text-sm text-gray-400">Rien de prévu pour ce jour.</p>
  <% else %>
    <% @daily_goals.each do |goal| %>
      <div class="px-4">
        <%= render "goals/goal", goal: goal, reference_date: @date, completion: @completions[[ goal.id, goal.occurrence_date(@date) ]] %>
      </div>
    <% end %>
    <% @weekly_goals.each do |goal| %>
      <div class="px-4">
        <%= render "goals/goal", goal: goal, reference_date: goal.occurrence_date(@date), completion: @completions[[ goal.id, goal.occurrence_date(@date) ]] %>
      </div>
    <% end %>
    <% @appointments.each do |appointment| %>
      <div class="px-4">
        <%= render "appointments/appointment", appointment: appointment %>
      </div>
    <% end %>
  <% end %>
</section>

<div class="flex flex-wrap gap-3">
  <%= link_to "+ Objectif du jour", new_goal_path(recurring: false, scheduled_on: @date), class: "text-sm px-3 py-2 rounded-md bg-indigo-600 text-white hover:bg-indigo-700" %>
  <%= link_to "+ Objectif récurrent", new_goal_path(recurring: true), class: "text-sm px-3 py-2 rounded-md border border-indigo-600 text-indigo-600 hover:bg-indigo-50" %>
  <%= link_to "+ Rendez-vous", new_appointment_path(date: @date), class: "text-sm px-3 py-2 rounded-md border border-indigo-600 text-indigo-600 hover:bg-indigo-50" %>
</div>
