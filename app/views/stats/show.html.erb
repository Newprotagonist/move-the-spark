<% content_for :title, "Statistiques — Move the Spark" %>

<%= render "shared/screen_header", kicker: "statistiques", title: "Tes statistiques" %>

<div class="rounded-[20px] bg-ink text-paper p-[18px] mb-5">
  <div class="font-mono text-[10px] tracking-[.16em] uppercase opacity-60">Taux de complétion global</div>
  <div class="font-serif-display text-[58px] leading-none mt-2">
    <%= @stats.global_completion_rate.nil? ? "—" : "#{@stats.global_completion_rate}%" %>
  </div>
  <% if @stats.global_completion_rate.nil? %>
    <div class="text-[12.5px] opacity-70 mt-2">Pas encore assez d’historique.</div>
  <% end %>
</div>

<div class="flex gap-2.5 mb-4">
  <div class="flex-1 rounded-[18px] bg-paper border border-line p-3.5">
    <% weekday = @stats.best_weekday %>
    <div class="font-serif-display text-[30px] leading-none">
      <%= weekday ? l(weekday.date, format: "%A").capitalize : "—" %>
    </div>
    <div class="text-[11.5px] text-dim mt-1">
      <%= weekday ? "meilleur jour (#{weekday.percent}%)" : "meilleur jour" %>
    </div>
  </div>
  <div class="flex-1 rounded-[18px] bg-paper border border-line p-3.5">
    <% recent = @stats.trend[:recent]; previous = @stats.trend[:previous] %>
    <div class="font-serif-display text-[30px] leading-none">
      <%= recent.rate.nil? ? "—" : "#{recent.rate}%" %>
    </div>
    <div class="text-[11.5px] text-dim mt-1">
      <% if previous.rate.nil? %>
        pas assez de données pour comparer
      <% else %>
        <% delta = recent.rate - previous.rate %>
        <%= delta.zero? ? "stable vs 2 sem. précédentes" : "#{delta.positive? ? "+" : ""}#{delta} pts vs 2 sem. précédentes" %>
      <% end %>
    </div>
  </div>
</div>

<div class="rounded-[18px] bg-paper border border-line p-4 mb-4">
  <div class="font-mono text-[10px] tracking-[.16em] uppercase text-dim mb-3">Les plus réalisés</div>
  <% if @stats.top_goals.empty? %>
    <p class="text-sm text-dim">Pas encore assez d’historique.</p>
  <% else %>
    <div class="flex flex-col gap-2">
      <% @stats.top_goals.each do |goal_rate| %>
        <div class="flex items-center justify-between gap-3 px-3.5 py-3 rounded-2xl border border-line">
          <p class="truncate text-[14.5px] font-semibold"><%= goal_rate.goal.title %></p>
          <span class="font-mono text-[11px] text-dim shrink-0"><%= goal_rate.rate %>% · <%= goal_rate.done %>/<%= goal_rate.total %></span>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<div class="rounded-[18px] bg-paper border border-line p-4 mb-4">
  <div class="font-mono text-[10px] tracking-[.16em] uppercase text-dim mb-3">Les moins réalisés</div>
  <% if @stats.bottom_goals.empty? %>
    <p class="text-sm text-dim">
      <%= @stats.top_goals.empty? ? "Pas encore assez d’historique." : "Rien d’autre à afficher ici pour l’instant." %>
    </p>
  <% else %>
    <div class="flex flex-col gap-2">
      <% @stats.bottom_goals.each do |goal_rate| %>
        <div class="flex items-center justify-between gap-3 px-3.5 py-3 rounded-2xl border border-line">
          <p class="truncate text-[14.5px] font-semibold"><%= goal_rate.goal.title %></p>
          <span class="font-mono text-[11px] text-dim shrink-0"><%= goal_rate.rate %>% · <%= goal_rate.done %>/<%= goal_rate.total %></span>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<%= link_to "← Retour", profile_path, class: "block mb-4 text-sm text-accent font-medium" %>
