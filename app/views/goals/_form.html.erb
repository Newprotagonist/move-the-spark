<%= form_with model: goal, class: "space-y-4" do |f| %>
  <% if goal.errors.any? %>
    <div class="rounded-md bg-red-50 text-red-800 text-sm px-4 py-3">
      <p class="font-medium mb-1"><%= pluralize(goal.errors.count, "erreur") %> :</p>
      <ul class="list-disc list-inside">
        <% goal.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= f.label :title, "Titre", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_field :title, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500", autofocus: true %>
  </div>

  <div>
    <%= f.label :description, "Notes (optionnel)", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :description, rows: 2, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= f.label :recurring, "Type", class: "block text-sm font-medium text-gray-700 mb-1" %>
    <div class="flex gap-4 text-sm">
      <label class="flex items-center gap-1">
        <%= f.radio_button :recurring, false, checked: !goal.recurring %>
        Ponctuel (un jour précis)
      </label>
      <label class="flex items-center gap-1">
        <%= f.radio_button :recurring, true, checked: goal.recurring %>
        Récurrent
      </label>
    </div>
  </div>

  <div>
    <%= f.label :scheduled_on, "Date", class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_field :scheduled_on, value: goal.scheduled_on || Date.current, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    <p class="text-xs text-gray-400 mt-1">Utilisé uniquement pour un objectif ponctuel.</p>
  </div>

  <div>
    <%= f.label :frequency, "Fréquence", class: "block text-sm font-medium text-gray-700" %>
    <%= f.select :frequency, [ [ "Chaque jour", "daily" ], [ "Chaque semaine", "weekly" ] ], {}, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    <p class="text-xs text-gray-400 mt-1">Utilisé uniquement pour un objectif récurrent.</p>
  </div>

  <div>
    <%= f.label :active_from, "Actif à partir du", class: "block text-sm font-medium text-gray-700" %>
    <%= f.date_field :active_from, value: goal.active_from || Date.current, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    <p class="text-xs text-gray-400 mt-1">Utilisé uniquement pour un objectif récurrent.</p>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "px-4 py-2 rounded-md bg-indigo-600 text-white text-sm hover:bg-indigo-700" %>
    <%= link_to "Annuler", request.referer || root_path, class: "text-sm text-gray-500 hover:underline" %>
    <% if goal.persisted? %>
      <%= button_to "Supprimer", goal_path(goal), method: :delete,
            class: "text-sm text-red-600 hover:underline bg-transparent border-0 p-0",
            form: { class: "ml-auto", data: { turbo_confirm: "Supprimer cet objectif ?" } } %>
    <% end %>
  </div>
<% end %>
