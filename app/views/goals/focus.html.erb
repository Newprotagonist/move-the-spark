<% content_for :title, "Focus — #{@goal.title} — Planner" %>

<% average_seconds = @goal.average_duration_seconds %>
<% total_seconds = average_seconds || 1500 %>

<div class="fixed inset-0 z-40 bg-[oklch(0.19_0.016_60)] text-[oklch(0.96_0.008_82)] flex flex-col items-center justify-center gap-6 px-7 py-14">
  <div class="font-mono text-[10px] tracking-[.2em] uppercase opacity-55">Focus</div>

  <div class="relative w-[236px] h-[236px] flex items-center justify-center"
       data-controller="timer" data-timer-started-at-value="<%= @goal.current_timer_started_at.iso8601 %>"
       data-timer-total-seconds-value="<%= total_seconds %>">
    <div data-timer-target="arc" class="absolute inset-0 rounded-full"
         style="background: conic-gradient(var(--color-accent) 0%, rgba(255,255,255,.14) 0)"></div>
    <div class="absolute inset-3 rounded-full bg-[oklch(0.19_0.016_60)] flex flex-col items-center justify-center gap-2">
      <div data-timer-target="display" class="font-mono text-[44px] tracking-tight">00:00</div>
      <div class="text-xs opacity-60">
        <%= average_seconds ? "moyenne #{(average_seconds / 60).round} min" : "sans moyenne" %>
      </div>
    </div>
  </div>

  <div class="text-center">
    <div class="font-serif-display text-2xl"><%= @goal.title %></div>
    <div class="text-xs opacity-55 mt-1">en cours</div>
  </div>

  <div class="w-full mt-1">
    <%= button_to "Terminé", stop_timer_goal_path(@goal), method: :post,
          params: { occurred_on: @occurred_on, return_to: day_path(date: @occurred_on) },
          class: "w-full py-4 rounded-2xl bg-success text-[oklch(0.1_0.02_155)] text-center text-[14px] font-bold",
          form: { data: { turbo: false } } %>
  </div>

  <%= button_to "Fermer sans enregistrer", cancel_timer_goal_path(@goal), method: :post,
        params: { occurred_on: @occurred_on, return_to: day_path(date: @occurred_on) },
        class: "font-mono text-[10.5px] opacity-50 bg-transparent border-0 p-2",
        form: { data: { turbo: false } } %>
</div>
