<%= turbo_frame_tag dom_id(goal, reference_date.to_s) do %>
  <div class="flex items-center gap-1 py-1">
    <%= button_to(
          completion ? uncomplete_goal_path(goal) : complete_goal_path(goal),
          method: :post,
          params: { occurred_on: reference_date },
          class: "shrink-0 flex items-center justify-center p-2.5",
          "aria-label": completion ? "Marquer comme non fait" : "Marquer comme fait",
          form: { data: { turbo_frame: dom_id(goal, reference_date.to_s) } }
        ) do %>
      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full border-2 text-xs font-bold
                   <%= completion ? "bg-green-500 border-green-500 text-white" : "border-gray-300 text-transparent hover:border-indigo-400" %>">
        ✓
      </span>
    <% end %>

    <div class="flex-1 min-w-0">
      <p class="truncate <%= "line-through text-gray-400" if completion %>"><%= goal.title %></p>
      <div class="flex items-center gap-2 mt-0.5">
        <% if goal.weekly? %>
          <span class="text-xs uppercase tracking-wide text-indigo-500">Cette semaine</span>
        <% elsif goal.recurring? %>
          <span class="text-xs uppercase tracking-wide text-gray-400">Chaque jour</span>
        <% end %>
        <% if goal.recurring? && (avg = goal.average_duration_seconds) %>
          <span class="text-xs text-gray-400">en moyenne <%= (avg / 60).round %> min</span>
        <% end %>
      </div>
    </div>

    <% if goal.timer_running? %>
      <span data-controller="timer" data-timer-started-at-value="<%= goal.current_timer_started_at.iso8601 %>"
            data-timer-target="display" class="text-xs text-gray-500 tabular-nums shrink-0">00:00</span>
      <%= button_to "⏹", stop_timer_goal_path(goal),
            method: :post, params: { occurred_on: reference_date }, class: "shrink-0 p-2.5 text-red-600",
            "aria-label": "Arrêter le chrono",
            form: { data: { turbo_frame: dom_id(goal, reference_date.to_s) } } %>
    <% elsif !completion %>
      <%= button_to "▶", start_timer_goal_path(goal),
            method: :post, params: { occurred_on: reference_date }, class: "shrink-0 p-2.5 text-gray-400 hover:text-indigo-600",
            "aria-label": "Démarrer le chrono",
            form: { data: { turbo_frame: dom_id(goal, reference_date.to_s) } } %>
    <% end %>

    <%= link_to "Modifier", edit_goal_path(goal), class: "text-xs text-gray-400 hover:text-gray-600 shrink-0 py-2.5" %>
  </div>
<% end %>
