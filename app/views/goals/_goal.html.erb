<% plannable = local_assigns.fetch(:plannable, true) %>
<%= turbo_frame_tag dom_id(goal, reference_date.to_s) do %>
  <div class="flex items-center gap-1 py-1">
    <%= button_to(
          completion ? uncomplete_goal_path(goal) : complete_goal_path(goal),
          method: :post,
          params: { occurred_on: reference_date },
          class: "shrink-0 flex items-center justify-center p-2.5",
          "aria-label": completion ? "Marquer comme non fait" : "Marquer comme fait",
          form: { data: { turbo_frame: dom_id(goal, reference_date.to_s) } }
        ) do %>
      <span class="inline-flex h-[26px] w-[26px] items-center justify-center rounded-full text-xs font-bold
                   <%= completion ? "bg-success text-white" : "border-[1.5px] border-line/90 text-transparent" %>">
        ✓
      </span>
    <% end %>

    <div class="flex-1 min-w-0">
      <p class="truncate text-[14.5px] font-semibold <%= "line-through text-faint" if completion %>"><%= goal.title %></p>
      <div class="flex items-center gap-2 mt-0.5">
        <% if goal.weekly? %>
          <span class="font-mono text-[9.5px] tracking-[.1em] uppercase px-1.5 py-1 rounded-md bg-accent-soft text-accent-dark">cette semaine</span>
        <% elsif goal.recurring? %>
          <span class="font-mono text-[9.5px] tracking-[.1em] uppercase px-1.5 py-1 rounded-md bg-line/60 text-dim">chaque jour</span>
        <% end %>
        <% if goal.scheduled_hour.present? %>
          <span class="font-mono text-[10.5px] text-dim"><%= format("%02d:00", goal.scheduled_hour) %></span>
        <% end %>
        <% if goal.recurring? && (avg = goal.average_duration_seconds) %>
          <span class="font-mono text-[10.5px] text-dim">≈ <%= (avg / 60).round %> min</span>
        <% end %>
      </div>
    </div>

    <% if goal.timer_running? %>
      <%= link_to focus_goal_path(goal, occurred_on: reference_date), "aria-label": "Reprendre le focus",
            data: { turbo_frame: "_top" }, class: "font-mono text-xs text-dim tabular-nums shrink-0 px-1" do %>
        <span data-controller="timer" data-timer-started-at-value="<%= goal.current_timer_started_at.iso8601 %>"
              data-timer-target="display">00:00</span>
      <% end %>
      <%= button_to "⏹", stop_timer_goal_path(goal),
            method: :post, params: { occurred_on: reference_date }, class: "shrink-0 p-2.5 text-red-600",
            "aria-label": "Arrêter le chrono",
            form: { data: { turbo_frame: dom_id(goal, reference_date.to_s) } } %>
    <% elsif !completion %>
      <% if plannable %>
        <button type="button" class="shrink-0 p-2.5 text-faint" aria-label="Caser dans le ruban" title="Caser dans le ruban"
                data-action="click->planning#start" data-planning-goal-id-param="<%= goal.id %>" data-planning-goal-title-param="<%= goal.title %>">
          <span class="inline-block w-[13px] h-[13px] rounded-full border-[1.5px] border-current relative">
            <span class="absolute left-1/2 top-0.5 w-[1.5px] h-[4.5px] bg-current"></span>
          </span>
        </button>
      <% end %>
      <% if goal.timed? %>
        <%= link_to focus_goal_path(goal, occurred_on: reference_date), "aria-label": "Démarrer le focus",
              data: { turbo_frame: "_top" }, class: "shrink-0 p-2.5 text-faint" do %>▶<% end %>
      <% end %>
    <% end %>

    <%= link_to "Modifier", edit_goal_path(goal), data: { turbo_frame: "sheet" },
          class: "font-mono text-[10.5px] text-dim shrink-0 py-2.5" %>
  </div>
<% end %>
