<% confetti = [
  [ 6, 0, 0, 6, 11, 1.9 ], [ 14, 0.28, 1, 5, 5, 2.2 ], [ 23, 0.1, 2, 4, 10, 1.7 ], [ 31, 0.44, 0, 7, 7, 2.1 ],
  [ 39, 0.06, 1, 5, 12, 2.0 ], [ 47, 0.34, 2, 4, 4, 1.8 ], [ 55, 0.16, 0, 6, 10, 2.2 ], [ 63, 0.5, 1, 5, 6, 1.9 ],
  [ 71, 0.22, 2, 7, 11, 2.1 ], [ 79, 0.4, 0, 4, 8, 1.7 ], [ 87, 0.12, 1, 6, 6, 2.0 ], [ 94, 0.3, 2, 5, 11, 2.2 ]
] %>
<% confetti_colors = [ "bg-accent", "bg-[oklch(0.84_0.14_74)]", "bg-[oklch(0.97_0.008_82)]" ] %>

<div data-controller="celebration"
     class="fixed inset-0 z-50 overflow-hidden flex flex-col items-center justify-center px-7 py-10 bg-[oklch(0.165_0.014_52_/_0.92)] animate-[pop-in_.3s_ease-out]"
     data-action="click->celebration#close">
  <% confetti.each do |left, delay, color_index, width, height, duration| %>
    <span class="absolute -top-5 rounded-[2px] opacity-0 <%= confetti_colors[color_index] %>"
          style="left: <%= left %>%; width: <%= width %>px; height: <%= height %>px; animation: confetti-fall <%= duration %>s cubic-bezier(.3,.5,.6,1) <%= delay %>s forwards"
          aria-hidden="true"></span>
  <% end %>

  <div class="relative text-center" data-action="click->celebration#stop">
    <div class="relative w-[150px] h-[150px] flex items-center justify-center mx-auto">
      <span class="absolute w-24 h-24 rounded-full animate-[ripple_2.2s_ease-out_infinite]" style="border: 1.5px solid var(--color-accent)"></span>
      <span class="absolute w-24 h-24 rounded-full animate-[ripple_2.2s_ease-out_.9s_infinite]" style="border: 1.5px solid var(--color-accent)"></span>
      <div class="relative w-[92px] h-[92px] rounded-full flex items-center justify-center animate-[pop-in_.55s_cubic-bezier(.34,1.56,.64,1)]"
           style="background: radial-gradient(120% 120% at 32% 14%, oklch(0.74 0.18 64), oklch(0.55 0.17 34) 66%, oklch(0.32 0.1 32)); box-shadow: 0 14px 44px oklch(0.55 0.17 40 / .55)">
        <%= render "shared/spark_glyph", size: "w-10 h-10", color: "bg-[oklch(0.985_0.02_85)]" %>
      </div>
    </div>

    <div class="font-serif-display text-[34px] leading-tight text-[oklch(0.97_0.008_82)] mt-1">La flamme monte</div>
    <p class="text-[12.5px] text-white/60 mt-2"><%= total %> objectif<%= "s" if total != 1 %> coché<%= "s" if total != 1 %> · rien laissé de côté</p>

    <div class="flex items-center justify-center gap-2.5 mt-6">
      <% if bonus.positive? %>
        <span class="px-3.5 py-2 rounded-full bg-white/10 text-[oklch(0.97_0.008_82)] font-mono text-[11.5px]">+<%= bonus %> étincelle<%= "s" if bonus != 1 %></span>
      <% end %>
      <span class="px-3.5 py-2 rounded-full bg-white/10 text-[oklch(0.97_0.008_82)] font-mono text-[11.5px]">flamme <%= streak - 1 %> → <%= streak %> j</span>
    </div>

    <button type="button" data-action="celebration#close"
            class="mt-7 px-8 py-3.5 rounded-2xl bg-[oklch(0.97_0.008_82)] text-ink text-sm font-bold">Continuer</button>
  </div>
</div>
