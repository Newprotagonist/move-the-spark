<%# One-shot flame + spark burst played when a goal is checked. Only ever
    rendered with bursting: true from a turbo_stream replace (see
    GoalsController#respond_to_toggle) — a plain page load never sees it,
    so it can't replay on every render, only on the toggle that caused it. %>
<span class="absolute left-1/2 -translate-x-1/2 bottom-[22px] w-12 h-10 -ml-6 pointer-events-none origin-bottom [mask-image:linear-gradient(to_top,transparent,#000_34%)] [-webkit-mask-image:linear-gradient(to_top,transparent,#000_34%)] animate-[flame-up_.9s_cubic-bezier(.2,.75,.3,1)_forwards]"
      aria-hidden="true">
  <span class="absolute left-1/2 bottom-0 rounded-[50%_0_50%_50%] blur-[3px] opacity-85 animate-[flame-a_1.05s_ease-in-out_infinite]"
        style="width:40px;height:40px;margin-left:-20px;background:linear-gradient(205deg, oklch(0.6 0.19 44), oklch(0.42 0.15 28))"></span>
  <span class="absolute left-1/2 bottom-px rounded-[50%_0_50%_50%] blur-[1.5px] animate-[flame-b_.82s_ease-in-out_infinite]"
        style="width:27px;height:27px;margin-left:-13.5px;background:linear-gradient(205deg, oklch(0.75 0.19 58), oklch(0.56 0.19 36))"></span>
  <span class="absolute left-1/2 bottom-0.5 rounded-[50%_0_50%_50%] animate-[flame-c_.6s_ease-in-out_infinite]"
        style="width:14px;height:14px;margin-left:-7px;background:linear-gradient(205deg, oklch(0.96 0.09 96), oklch(0.82 0.16 68))"></span>
</span>
<% [ [ 38, 44, -9, 190 ], [ 58, 52, 7, 300 ], [ 46, 36, 2, 430 ] ].each do |left, rise, drift, delay| %>
  <span class="absolute bottom-3.5 w-[3px] h-[3px] rounded-full bg-accent pointer-events-none opacity-0"
        style="left: <%= left %>%; --rise: <%= rise %>px; --drift: <%= drift %>px; animation: ember-fly .95s cubic-bezier(.2,.6,.4,1) <%= delay %>ms forwards"
        aria-hidden="true"></span>
<% end %>
