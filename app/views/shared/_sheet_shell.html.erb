<%# Provides the "sheet" turbo-frame itself (not just its chrome) — Turbo Rails
    renders frame-scoped requests through its own bare layout, bypassing
    app/views/layouts/application.html.erb entirely, so this has to be the one
    place that actually emits <turbo-frame id="sheet">. Every sheet-style view
    (goals/new, appointments/edit, settings/edit, …) renders through this same
    layout, so exactly one such frame ever exists per response either way. %>
<%= turbo_frame_tag "sheet", class: "fixed inset-0 z-40 flex flex-col justify-end", data: { controller: "sheet" } do %>
  <div class="absolute inset-0 bg-[oklch(0.19_0.016_60_/_0.34)]" data-action="click->sheet#close"></div>
  <div data-sheet-card
       class="relative bg-[oklch(0.985_0.006_84)] rounded-t-[26px] px-5 pt-2.5 pb-10 max-h-[82%] overflow-y-auto
              animate-[sheet-up_.26s_cubic-bezier(.22,.8,.28,1)] shadow-[0_-10px_40px_rgba(0,0,0,.18)]">
    <div class="w-[38px] h-1 rounded-full bg-line mx-auto mb-4"></div>
    <div class="flex items-baseline justify-between mb-5">
      <div class="font-serif-display text-2xl"><%= title %></div>
      <button type="button" data-action="click->sheet#close" class="font-mono text-[10.5px] text-dim p-2">FERMER</button>
    </div>
    <%= yield %>
  </div>
<% end %>
