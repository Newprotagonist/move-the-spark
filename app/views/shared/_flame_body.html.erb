<%# A "living flame" visual reused by the profile hero and the Focus screen:
    a blurred halo behind three stacked, independently-flickering blobs
    (dark → bright → pale), scaled/faded by `intensity` (0..1). When `live`
    is true, the halo/body carry data-timer-target attributes so
    timer_controller.js can override their inline transform/opacity every
    tick (Focus); otherwise they're static, computed once server-side
    (profile hero, from the current level's progress). %>
<% intensity = intensity.clamp(0.0, 1.0) %>
<% live = local_assigns.fetch(:live, false) %>
<% scale = (0.28 + intensity * 0.84).round(3) %>
<% body_opacity = [ 1.0, 0.16 + intensity * 1.8 ].min.round(2) %>
<% halo_opacity = (0.22 + intensity * 0.62).round(2) %>
<div class="relative w-full h-full flex items-end justify-center overflow-hidden">
  <div <%= "data-timer-target=\"fireHalo\"".html_safe if live %>
       class="absolute left-1/2 bottom-1 -translate-x-1/2 rounded-full blur-2xl animate-[swell_5.4s_ease-in-out_infinite]"
       style="width: 220px; height: 220px; background: radial-gradient(circle, oklch(0.68 0.19 48 / .5), transparent 65%); opacity: <%= halo_opacity %>"></div>
  <div <%= "data-timer-target=\"fireBody\"".html_safe if live %>
       class="absolute left-0 right-0 bottom-0 origin-bottom"
       style="height: 122px; transform: scale(<%= scale %>); opacity: <%= body_opacity %>; transition: transform 1.2s cubic-bezier(.3,.85,.3,1), opacity 1.2s ease-out">
    <span class="absolute left-1/2 bottom-0 rounded-[50%_0_50%_50%] blur-md opacity-80 animate-[flame-a_3.1s_ease-in-out_infinite]"
          style="width:122px;height:122px;margin-left:-61px;background:linear-gradient(205deg, oklch(0.6 0.19 44), oklch(0.42 0.15 28))"></span>
    <span class="absolute left-1/2 bottom-0.5 rounded-[50%_0_50%_50%] blur-[3px] animate-[flame-b_2.3s_ease-in-out_infinite]"
          style="width:86px;height:86px;margin-left:-43px;background:linear-gradient(205deg, oklch(0.75 0.19 58), oklch(0.56 0.19 36))"></span>
    <span class="absolute left-1/2 bottom-1 rounded-[50%_0_50%_50%] blur-[1px] animate-[flame-c_1.6s_ease-in-out_infinite]"
          style="width:50px;height:50px;margin-left:-25px;background:linear-gradient(205deg, oklch(0.96 0.09 96), oklch(0.82 0.16 68))"></span>
  </div>
</div>
