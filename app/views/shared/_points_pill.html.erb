<%= link_to profile_path, id: "gamification-summary",
      class: "shrink-0 flex items-center gap-2 px-3 py-2 rounded-full bg-ink text-paper font-mono text-xs min-h-9" do %>
  <span class="flex items-center gap-1.5">
    <%= render "shared/spark_glyph", size: "w-2.5 h-2.5", color: "bg-accent" %>
    <span><%= @total_points %></span>
  </span>
  <span class="w-px h-3 bg-white/25"></span>
  <span class="flex items-center gap-1.5">
    <%= render "shared/flame_glyph", size: "w-2.5 h-2.5", color: "bg-accent" %>
    <span><%= @daily_streak %></span>
  </span>
<% end %>
